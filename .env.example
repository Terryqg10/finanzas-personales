# --- Supabase (se completa en Fase 1) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- API de tasas de cambio (se completa en Fase 7) ---
EXCHANGE_RATE_API_KEY=

# --- Email transaccional: avisos de presupuesto (clave de Resend de solo envío; si falta, no se envía) ---
RESEND_API_KEY=

# --- Notificaciones push: claves VAPID (generar con: npx web-push generate-vapid-keys) ---
# La pública la necesita el navegador (lleva NEXT_PUBLIC_); la privada es secreta y solo la lee el servidor.
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
